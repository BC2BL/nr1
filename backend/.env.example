# ─────────────────────────────────────────────────────────────────────────────
# 2BeLive NR-1 Diagnostic Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit a real .env file to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password_here
DB_NAME=nr1_diagnostic

# JWT secret — generate with: openssl rand -hex 32
# Never use the placeholder below in production.
JWT_SECRET=replace-this-with-a-real-random-secret

# Server port (defaults to 3000 if not set)
PORT=3000
